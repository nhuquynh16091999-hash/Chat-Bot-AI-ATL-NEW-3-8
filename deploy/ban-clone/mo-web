#!/bin/bash
# Mở trang quản lý AI Sale (https://139.180.131.21:8449) cho IP của máy đang SSH vào.
#   ssh root@139.180.131.21 mo-web            thêm IP hiện tại (giữ 3 IP gần nhất)
#   ssh root@139.180.131.21 mo-web --xem      xem các IP đang được mở
#   ssh root@139.180.131.21 mo-web --dong-het chặn hết (không ai mở được web nữa)
set -euo pipefail
F=/etc/nginx/aisale-web/ip-cho-phep.conf
mkdir -p "$(dirname "$F")"; touch "$F"

nap_lai() {
    if nginx -t -q 2>/dev/null; then systemctl reload nginx; else
        cp -p "$F.truoc" "$F"; echo "✗ Cấu hình nginx lỗi — đã trả lại như cũ."; exit 1; fi
}

case "${1:-}" in
  --xem)  echo "IP đang mở web:"; grep -oE "allow [^;]+" "$F" | sed 's/allow /  · /' || echo "  (chưa có)"; exit 0 ;;
  --dong-het) cp -p "$F" "$F.truoc"; echo "# đóng hết $(date '+%d/%m/%Y %H:%M')" > "$F"; nap_lai; echo "✓ Đã chặn hết."; exit 0 ;;
esac

ip="${SSH_CLIENT%% *}"
if ! [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || "$ip" =~ ^[0-9a-fA-F:]+$ ]]; then
    echo "✗ Không đọc được IP của máy đang SSH vào (chạy lệnh này qua ssh)."; exit 1
fi
# IP này đang đứng đầu danh sách rồi → khỏi ghi, khỏi nạp lại nginx (máy Mac gọi lệnh này 5 phút/lần).
if [ "$(grep -m1 -oE "^allow [^;]+" "$F" 2>/dev/null)" = "allow $ip" ]; then
    echo "✓ IP $ip đã được mở sẵn — https://139.180.131.21:8449"; exit 0
fi
cp -p "$F" "$F.truoc"
# Giữ IP mới + 2 IP gần nhất: IP nhà mạng cấp động, IP cũ sẽ về tay khách khác của nhà mạng.
{ echo "allow $ip;  # $(date '+%d/%m/%Y %H:%M')"
  grep -E "^allow " "$F" | grep -vF "allow $ip;" | head -2 || true; } > "$F.moi"
mv "$F.moi" "$F"
nap_lai
echo "✓ Đã mở web cho IP $ip"
echo "  Link: https://139.180.131.21:8449"
